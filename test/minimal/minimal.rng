<?xml version="1.0" encoding="UTF-8"?>
<grammar xmlns="http://relaxng.org/ns/structure/1.0">
  <start>
    <ref name="note"/>
  </start>

  <define name="note">
    <element name="note">
      <ref name="title"/>
    </element>
  </define>

  <define name="title">
    <element name="title">
      <text/>
    </element>
  </define>
</grammar>
